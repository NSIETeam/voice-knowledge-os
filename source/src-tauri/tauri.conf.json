{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoneyVoice",
  "version": "0.1.3",
  "identifier": "com.miraphant.voice-memory",
  "build": {
    "beforeDevCommand": "bash scripts/build-native.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build-native.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HoneyVoice",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/audio-capture", "binaries/macos-speech", "binaries/speaker-diarize", "binaries/humla-mcp"],
    "resources": {
      "resources/default.metallib": "default.metallib"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["honeyvoice"]
      }
    }
  }
}
