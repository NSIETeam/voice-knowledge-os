{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Memory",
  "version": "0.1.0",
  "identifier": "com.voicememory.desktop",
  "build": {
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "shell": {
      "open": false
    }
  },
  "app": {
    "windows": [{
      "title": "Voice Memory",
      "width": 900,
      "height": 680,
      "minWidth": 640,
      "minHeight": 480,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/voice-memory-node"],
    "targets": ["app", "msi", "dmg"],
    "createUpdaterArtifacts": false
  }
}
